# Daiso 3D Fitter Frontend Environment Variables
VITE_API_BASE_URL=http://127.0.0.1:8001

# Google OAuth 2.0 Web Client ID (from Google Cloud Console)
# e.g.: 123456789-abcdef.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=

# Kakao JavaScript App Key (from Kakao Developers)
# e.g.: 1234567890abcdef1234567890abcdef
VITE_KAKAO_JAVASCRIPT_KEY=
